rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Top level lockdown - Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Secure user profiles: Users can only read/write their own profiles
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Secure emergency alerts: Users can create alerts, responders can read
    match /emergencies/{alertId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null;
      allow delete: if false; // Audit trail preservation
    }
    
    // Secure venue mapping data: Read only for authenticated attendees
    match /venues/{venueId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
